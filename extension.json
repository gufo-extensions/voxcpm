{
  "schema": 1,
  "name": "voxcpm",
  "version": "0.1.1",
  "api_version": ">= 0.3.0",
  "depends": [],
  "platforms": ["linux"],
  "entry": "voxcpm_register",
  "registration_target": "gufo_voxcpm",
  "targets": {
    "gufo_voxcpm": { "requires": [] },
    "gufo_voxcpm_hip": { "requires": ["hip"] },
    "gufo_voxcpm_tts": { "requires": ["hip"] },
    "voxcpm_config_test": { "requires": ["testing"], "role": "test" },
    "voxcpm_probe_test": { "requires": ["testing"], "role": "test" },
    "voxcpm_tokenizer_test": { "requires": ["testing"], "role": "test" },
    "voxcpm_weights_test": { "requires": ["testing"], "role": "test" },
    "voxcpm_generator_test": { "requires": ["hip", "testing"], "role": "test" },
    "voxcpm_vae_test": { "requires": ["hip", "testing"], "role": "test" },
    "voxcpm_products_test": { "requires": ["hip", "testing"], "role": "test" },
    "voxcpm_synthesize": { "requires": ["hip", "testing"], "role": "test" },
    "voxcpm_gemm_bench": { "requires": ["hip", "testing"], "role": "test" }
  },
  "providers": [
    {
      "id": "voxcpm2",
      "capability": "speech_synthesis",
      "keys": ["safetensors:voxcpm2", "gguf:audiocpp"],
      "model_ids": ["voxcpm2"],
      "target": "gufo_voxcpm_tts",
      "entry": "voxcpm2_provider_register",
      "serving": { "voices": true }
    }
  ],
  "models": [
    {
      "id": "voxcpm2",
      "provider": "voxcpm2",
      "license": "apache-2.0",
      "description": "OpenBMB VoxCPM2, safetensors",
      "components": [
        {
          "role": "weights",
          "option": "--model",
          "install": "required",
          "entry": ".",
          "source": {
            "hf": "openbmb/VoxCPM2",
            "revision": "7936080b41163874f38610f46f438e2c0757f9fd"
          },
          "include": ["config.json", "model.safetensors", "audiovae.pth", "tokenizer.json"]
        }
      ]
    },
    {
      "id": "voxcpm2-q8",
      "provider": "voxcpm2",
      "license": "apache-2.0",
      "description": "OpenBMB VoxCPM2, audio.cpp's Q8_0 GGUF",
      "components": [
        {
          "role": "weights",
          "option": "--model",
          "install": "required",
          "source": {
            "hf": "audio-cpp/audio.cpp-gguf",
            "revision": "661a224e9d9adbd49c01626f85e426f5f425d771"
          },
          "include": ["VoxCPM2-GGUF/voxcpm2-q8_0.gguf"]
        }
      ]
    }
  ],
  "licenses": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/gufo.txt",
    "licenses/VoxCPM.txt",
    "licenses/DAC.txt",
    "licenses/CosyVoice.txt"
  ]
}
